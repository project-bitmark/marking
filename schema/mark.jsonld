{
  "@context": "../context.jsonld",
  "@graph": [
    {
      "@id": "mk:mark",
      "@type": "Module",
      "label": "mark",
      "version": "0.0.1",
      "layer": "value",
      "seeAlso": "https://github.com/project-bitmark/marking/wiki",
      "comment": "The unit of the whole system. The wiki (2014) defines marking as 'the process of giving reputation, giving someone a mark for something they have created, offered, or shared', and says marks 'are a limited resource, the process of marking transfers ownership of the marks from one user to another'. So a mark is a transfer with a subject: who gave, who received, how much, and an IRI for the thing it was given for. A like is free; a mark is spent. That is what makes the sum of marks an honest measure of value, and what makes this object usable as a grade in the loop the other four modules describe. The subject can be anything with an IRI: a web address (getMarked), a commit (gitmark), a person, an issue, a song. A mark can itself be the subject of a mark: a public mark of a link is a share, and marking the share rewards the link and the sharer at once (see the settlement rules below)."
    },
    {
      "@id": "mk:Mark",
      "@type": "Struct",
      "module": "mk:mark",
      "label": "Mark",
      "comment": "One transfer of marks given as reputation. The amount is in marks, divisible to five decimal places as the wiki fixes it (0.00001 marks = 0.01 markbits). 'to' may be unresolved: a mark on a thing nobody has claimed is owed, not paid. 'tx' points at the Bitmark transaction that moved the marks once it exists; until then the object is a promise and nothing in the loop should treat it as settled.",
      "fields": [
        {
          "property": "mk:from",
          "label": "from",
          "key": "from",
          "valueType": "iri",
          "required": true,
          "comment": "Who gives. An IRI for a key or account: a Bitmark address, a nostr npub, a DID, a GitHub account. The marks leave this party."
        },
        {
          "property": "mk:to",
          "label": "to",
          "key": "to",
          "valueType": "iri",
          "required": false,
          "comment": "Who receives, when known. Same kinds of IRI as 'from'. Absent when the subject has no owner yet: the mark is then owed to whoever claims the subject, by a key the subject carries or by a later claim, which is how the wiki treats an unclaimed page ('any page with a getMarked button is considered to be claimed by the content creator'). Settlement resolves it; until then the marks stay with the giver as a debt."
        },
        {
          "property": "mk:amount",
          "label": "amount",
          "key": "amount",
          "valueType": "decimal",
          "required": true,
          "comment": "Marks transferred, as a decimal string with at most five decimal places. Positive."
        },
        {
          "property": "mk:subject",
          "label": "subject",
          "key": "subject",
          "valueType": "iri",
          "required": true,
          "comment": "What the mark is for. Any IRI. The reputation accrues to 'to' and the rank accrues to this subject, which is how the wiki's 'a measure of marks received over a period of time gives each marked thing a rank' is computed."
        },
        {
          "property": "mk:reason",
          "label": "reason",
          "key": "reason",
          "valueType": "utf8",
          "required": false,
          "comment": "Free text from the giver. Not interpreted."
        },
        {
          "property": "mk:at",
          "label": "at",
          "key": "at",
          "valueType": "datetime",
          "required": true,
          "comment": "When the mark was given, RFC 3339."
        },
        {
          "property": "mk:tx",
          "label": "tx",
          "key": "tx",
          "valueType": "iri",
          "required": false,
          "comment": "The on-chain transfer, as a txo: IRI (txo:<chain>:<txid>:<vout>, the scheme bitcoin-kernel's utxo page resolves) or a transaction URL. Absent until broadcast."
        },
        {
          "property": "mk:sig",
          "label": "sig",
          "key": "sig",
          "valueType": "utf8",
          "required": false,
          "comment": "Signature by 'from' over the canonical object, for marks that live off chain or precede their transaction. Scheme follows the key kind of 'from'."
        }
      ]
    },
    {
      "@id": "mk:settlementRules",
      "@type": "RuleSet",
      "module": "mk:mark",
      "label": "settlementRules",
      "comment": "How a mark with no 'to' finds its recipients when it is settled. The wiki: curators 'receive the marks given to them for sharing the link', a claimed page's marks 'are split between the marker and the creator', and 'anybody who further shares a marking elsewhere will receive a portion'. A share is a Mark whose subject is the link; marking the share, rather than the bare link, keeps both the link and the sharer in one object, so the rank of links and the rank of curators are two groupings of the same marks.",
      "rules": [
        {
          "@id": "mk:rule-settle-key-in-subject",
          "@type": "ValidationRule",
          "label": "settle-key-in-subject",
          "errorCode": "settle-unresolved",
          "check": "if 'to' is absent and the subject carries a key (a Mark's 'from', a signed event's pubkey, a DID), that key is the recipient",
          "comment": "A share is a Mark, so its sharer is its 'from'. The first resolution step and the one that makes marking a share pay the curator."
        },
        {
          "@id": "mk:rule-settle-split-claimed",
          "@type": "ValidationRule",
          "label": "settle-split-claimed",
          "errorCode": "settle-split",
          "check": "if the subject is a share of a link whose creator has claimed it, the amount is split between sharer and creator by the share-split Rule the settlement names; unclaimed, the sharer takes all",
          "comment": "The split is a Rule with a fixed ratio, declared, so a sharer knows before sharing what a claim will cost them. Claiming is the creator proving a key for the link."
        },
        {
          "@id": "mk:rule-settle-reshare-chain",
          "@type": "ValidationRule",
          "label": "settle-reshare-chain",
          "errorCode": "settle-chain",
          "check": "a share whose subject is itself a share applies the split again one level up, so each re-sharer takes a portion of what their share receives",
          "comment": "The wiki's 'further shares a marking elsewhere'. Bounded by the chain of shares, which is finite and signed at every link."
        },
        {
          "@id": "mk:rule-settle-unclaimed-owed",
          "@type": "ValidationRule",
          "label": "settle-unclaimed-owed",
          "errorCode": "settle-owed",
          "check": "a mark whose subject resolves to nobody stays unsettled: owed, debited from the giver's budget, payable on a later claim",
          "comment": "Nothing is paid to an address nobody holds. The debt is the incentive to claim."
        }
      ]
    }
  ]
}
