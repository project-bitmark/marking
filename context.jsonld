{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://bitmark.co/marking/",
    "mk": "https://bitmark.co/marking/",
    "bts": "https://torrent-schema.github.io/meta#",
    "btc": "https://bitcoin-kernel.com/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "seeAlso": { "@id": "rdfs:seeAlso", "@type": "@id" },
    "version": "schema:version",
    "Module": "bts:Module",
    "Struct": "bts:Struct",
    "Enumeration": "bts:Enumeration",
    "RuleSet": "bts:RuleSet",
    "ValidationRule": "bts:ValidationRule",
    "module": { "@id": "bts:module", "@type": "@id" },
    "layer": "bts:layer",
    "fields": { "@id": "bts:fields", "@container": "@list" },
    "members": { "@id": "bts:members", "@container": "@list" },
    "rules": { "@id": "bts:rules", "@container": "@list" },
    "property": { "@id": "bts:property", "@type": "@id" },
    "key": "bts:key",
    "valueType": "bts:valueType",
    "structType": { "@id": "bts:structType", "@type": "@id" },
    "required": "bts:required",
    "check": "bts:check",
    "errorCode": "bts:errorCode",
    "value": "bts:value",

    "from": { "@id": "mk:from", "@type": "@id" },
    "to": { "@id": "mk:to", "@type": "@id" },
    "by": { "@id": "mk:by", "@type": "@id" },
    "subject": { "@id": "mk:subject", "@type": "@id" },
    "task": { "@id": "mk:task", "@type": "@id" },
    "rule": { "@id": "mk:rule", "@type": "@id" },
    "bounty": { "@id": "mk:bounty", "@type": "@id" },
    "claim": { "@id": "mk:claim", "@type": "@id" },
    "anchor": { "@id": "mk:anchor", "@type": "@id" },
    "verdict": { "@id": "mk:verdict", "@type": "@id" },
    "tx": { "@id": "mk:tx", "@type": "@id" },
    "vectors": { "@id": "mk:vectors", "@type": "@id" },
    "amount": "mk:amount",
    "reason": "mk:reason",
    "at": { "@id": "mk:at", "@type": "xsd:dateTime" },
    "expires": { "@id": "mk:expires", "@type": "xsd:dateTime" },
    "outcome": "mk:outcome",
    "evidence": "mk:evidence",
    "kind": "mk:kind",
    "procedure": "mk:procedure",
    "threshold": "mk:threshold",
    "window": "mk:window",
    "sig": "mk:sig"
  }
}
